{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SynapCode",
  "version": "0.1.0",
  "identifier": "com.savants.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SynapCode",
        "width": 900,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/falkordb-server",
      "binaries/temporal-server"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
