{
  "name": "savants-cloud-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "./scripts/migrate.sh && wrangler deploy",
    "deploy:staging": "./scripts/migrate.sh --staging && wrangler deploy --env staging",
    "db:migrate": "./scripts/migrate.sh",
    "db:migrate:staging": "./scripts/migrate.sh --staging",
    "db:migrate:dry-run": "./scripts/migrate.sh --dry-run",
    "db:status": "./scripts/migrate.sh --status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "vitest": "~2.1.0",
    "wrangler": "^3.91.0"
  }
}
