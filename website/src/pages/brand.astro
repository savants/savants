---
import Base from '../layouts/Base.astro';
---
<Base title="Brand Assets - Savants" description="Download Savants logos, icons, and brand guidelines.">
<style>
  .brand { max-width: 900px; margin: 0 auto; padding: 120px 24px 80px; }
  .brand h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 8px; }
  .brand .subtitle { color: var(--muted); font-size: 0.95rem; margin-bottom: 48px; }
  .brand h2 { font-size: 1.3rem; font-weight: 700; margin-top: 48px; margin-bottom: 20px; }
  .brand p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 16px; }

  .asset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 32px; }
  .asset-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    overflow: hidden; transition: border-color 0.2s, transform 0.2s;
  }
  .asset-card:hover { border-color: rgba(34,211,238,0.3); transform: translateY(-2px); }
  .asset-preview {
    background: #0a0a0a; padding: 24px; display: flex; align-items: center; justify-content: center;
    min-height: 160px; border-bottom: 1px solid var(--border);
  }
  .asset-preview img { max-width: 100%; max-height: 120px; object-fit: contain; }
  .asset-preview.dark { background: #0a0a0a; }
  .asset-preview.light { background: #f5f5f5; }
  .asset-info { padding: 16px; }
  .asset-name { font-weight: 600; font-size: 0.9rem; margin-bottom: 4px; }
  .asset-meta { color: var(--muted); font-size: 0.75rem; margin-bottom: 12px; }
  .asset-dl {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px;
    background: rgba(34,211,238,0.1); color: var(--accent); border-radius: 6px;
    text-decoration: none; font-size: 0.8rem; font-weight: 500; transition: background 0.2s;
  }
  .asset-dl:hover { background: rgba(34,211,238,0.2); }

  .color-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-bottom: 32px; }
  .color-swatch {
    border-radius: 10px; overflow: hidden; border: 1px solid var(--border);
  }
  .color-block { height: 80px; }
  .color-info { padding: 10px; background: var(--surface); }
  .color-name { font-size: 0.8rem; font-weight: 600; margin-bottom: 2px; }
  .color-hex { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--muted); cursor: pointer; }
  .color-hex:hover { color: var(--accent); }

  .type-sample { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; margin-bottom: 16px; }
  .type-name { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }

  .guidelines { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; }
  .guidelines ul { padding-left: 20px; }
  .guidelines li { color: var(--muted); font-size: 0.9rem; line-height: 1.8; }
  .guidelines li strong { color: var(--fg); }

  @media (max-width: 768px) {
    .brand { padding: 80px 16px 60px; }
    .asset-grid { grid-template-columns: 1fr; }
    .color-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<nav style="position:fixed;top:0;left:0;right:0;z-index:100;padding:18px 32px;backdrop-filter:blur(16px);background:rgba(10,10,10,0.92);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
  <a href="/" style="font-weight:700;font-size:1.1rem;color:var(--fg);text-decoration:none;">savants</a>
  <a href="/" style="color:var(--muted);font-size:0.85rem;text-decoration:none;">Back to home</a>
</nav>

<div class="brand">
  <h1>Brand Assets</h1>
  <p class="subtitle">Download logos, icons, and brand guidelines for Savants.</p>

  <h2>Logos</h2>
  <div class="asset-grid">
    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/og-image.png" alt="Savants Brain Logo">
      </div>
      <div class="asset-info">
        <div class="asset-name">Brain Logo (Primary)</div>
        <div class="asset-meta">1408 &times; 768 PNG &middot; 844KB</div>
        <a href="https://releases.savants.dev/assets/og-image.png" download class="asset-dl">Download PNG</a>
      </div>
    </div>

    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/logo-dark.svg" alt="Logo Dark" style="max-height:80px">
      </div>
      <div class="asset-info">
        <div class="asset-name">Icon (Dark Background)</div>
        <div class="asset-meta">SVG &middot; 328B</div>
        <a href="https://releases.savants.dev/assets/logo-dark.svg" download class="asset-dl">Download SVG</a>
      </div>
    </div>

    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/logo-wordmark.svg" alt="Wordmark" style="max-height:40px">
      </div>
      <div class="asset-info">
        <div class="asset-name">Wordmark</div>
        <div class="asset-meta">SVG &middot; 305B</div>
        <a href="https://releases.savants.dev/assets/logo-wordmark.svg" download class="asset-dl">Download SVG</a>
      </div>
    </div>

    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/favicon.svg" alt="Favicon" style="max-height:48px">
      </div>
      <div class="asset-info">
        <div class="asset-name">Favicon</div>
        <div class="asset-meta">SVG &middot; 247B</div>
        <a href="https://releases.savants.dev/assets/favicon.svg" download class="asset-dl">Download SVG</a>
      </div>
    </div>
  </div>

  <h2>Feature Images</h2>
  <div class="asset-grid">
    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/graph-viz.png" alt="Knowledge Graph">
      </div>
      <div class="asset-info">
        <div class="asset-name">Knowledge Graph</div>
        <div class="asset-meta">PNG &middot; 1.1MB</div>
        <a href="https://releases.savants.dev/assets/graph-viz.png" download class="asset-dl">Download PNG</a>
      </div>
    </div>

    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/diagnose-feature.png" alt="Error Diagnosis">
      </div>
      <div class="asset-info">
        <div class="asset-name">Error Diagnosis</div>
        <div class="asset-meta">PNG &middot; 975KB</div>
        <a href="https://releases.savants.dev/assets/diagnose-feature.png" download class="asset-dl">Download PNG</a>
      </div>
    </div>

    <div class="asset-card">
      <div class="asset-preview dark">
        <img src="https://releases.savants.dev/assets/pr-risk-feature.png" alt="PR Risk Analysis">
      </div>
      <div class="asset-info">
        <div class="asset-name">PR Risk Analysis</div>
        <div class="asset-meta">PNG &middot; 1.1MB</div>
        <a href="https://releases.savants.dev/assets/pr-risk-feature.png" download class="asset-dl">Download PNG</a>
      </div>
    </div>
  </div>

  <h2>Colors</h2>
  <div class="color-grid">
    <div class="color-swatch">
      <div class="color-block" style="background:#22d3ee"></div>
      <div class="color-info">
        <div class="color-name">Cyan (Primary)</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#22d3ee')">#22d3ee</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#a78bfa"></div>
      <div class="color-info">
        <div class="color-name">Violet (Secondary)</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#a78bfa')">#a78bfa</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#0a0a0a"></div>
      <div class="color-info">
        <div class="color-name">Background</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#0a0a0a')">#0a0a0a</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#141414"></div>
      <div class="color-info">
        <div class="color-name">Surface</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#141414')">#141414</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#e5e5e5"></div>
      <div class="color-info">
        <div class="color-name">Foreground</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#e5e5e5')">#e5e5e5</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#4ade80"></div>
      <div class="color-info">
        <div class="color-name">Success</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#4ade80')">#4ade80</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#f87171"></div>
      <div class="color-info">
        <div class="color-name">Error</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#f87171')">#f87171</div>
      </div>
    </div>
    <div class="color-swatch">
      <div class="color-block" style="background:#262626"></div>
      <div class="color-info">
        <div class="color-name">Border</div>
        <div class="color-hex" onclick="navigator.clipboard.writeText('#262626')">#262626</div>
      </div>
    </div>
  </div>

  <h2>Typography</h2>
  <div class="type-sample">
    <div class="type-name">Headlines - Inter 800</div>
    <div style="font-size:2rem;font-weight:800;letter-spacing:-0.03em">Your AI agent just got 10x smarter.</div>
  </div>
  <div class="type-sample">
    <div class="type-name">Body - Inter 400</div>
    <div style="font-size:1rem;line-height:1.6;color:var(--muted)">Stop watching your AI read 47 files to find one function. Savants gives it the answer in one call.</div>
  </div>
  <div class="type-sample">
    <div class="type-name">Code - JetBrains Mono 400</div>
    <div style="font-family:'JetBrains Mono',monospace;font-size:0.9rem;color:var(--accent)">curl -fsSL savants.sh | sh</div>
  </div>

  <h2>Guidelines</h2>
  <div class="guidelines">
    <ul>
      <li><strong>Name:</strong> savants (lowercase, no capital S)</li>
      <li><strong>Cloud product:</strong> savants.cloud</li>
      <li><strong>Never:</strong> Savant (singular), SAVANTS (all caps), Savant's</li>
      <li><strong>Logo on dark backgrounds:</strong> Use the brain logo or cyan "S" mark</li>
      <li><strong>Logo on light backgrounds:</strong> Use dark "S" mark or wordmark</li>
      <li><strong>Minimum size:</strong> 24px for icon, 80px for wordmark</li>
      <li><strong>Clear space:</strong> Maintain at least 1x the icon width around the logo</li>
      <li><strong>Gradient:</strong> Primary accent gradient is linear-gradient(135deg, #22d3ee, #a78bfa)</li>
      <li><strong>Film grain:</strong> Subtle SVG noise overlay at 3% opacity on all dark surfaces</li>
    </ul>
  </div>
</div>
</Base>
