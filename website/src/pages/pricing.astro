---
import Base from '../layouts/Base.astro';
---
<Base title="Savants - Pricing" description="Know what's wrong in 60 seconds. Plans starting at $499/mo.">
<style>
  .pricing-page { min-height: 100vh; padding: 120px 32px 80px; }
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 18px 32px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(16px); background: rgba(10,10,10,0.9); border-bottom: 1px solid var(--border); }
  nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  nav .brand span { color: var(--accent); }
  nav .links { display: flex; gap: 24px; align-items: center; }
  nav .links a { color: var(--muted); text-decoration: none; font-size: 0.88rem; transition: color 0.2s; }
  nav .links a:hover { color: var(--fg); }
  nav .nav-cta { padding: 7px 18px; background: var(--accent); color: var(--bg); font-weight: 600; border-radius: 8px; text-decoration: none; font-size: 0.85rem; }

  .pricing-header { text-align: center; max-width: 600px; margin: 0 auto 48px; }
  .pricing-header h1 { font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px; }
  .pricing-header p { color: var(--muted); font-size: 1.05rem; line-height: 1.6; }

  .plans { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; max-width: 1100px; margin: 0 auto 64px; }
  @media (max-width: 900px) { .plans { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .plans { grid-template-columns: 1fr; } }

  .plan { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 32px 28px; display: flex; flex-direction: column; transition: border-color 0.3s, transform 0.3s; }
  .plan:hover { border-color: #444; transform: translateY(-3px); }
  .plan.featured { border-color: var(--accent); position: relative; }
  .plan.featured::before { content: 'Most Popular'; position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--accent); color: var(--bg); font-size: 0.68rem; font-weight: 700; padding: 3px 14px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.05em; }

  .plan-tier { font-size: 0.72rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 8px; }
  .plan.featured .plan-tier { color: var(--accent); }
  .plan-price { font-size: 2.2rem; font-weight: 800; margin-bottom: 2px; letter-spacing: -0.02em; }
  .plan-price .currency { font-size: 1.2rem; vertical-align: top; color: var(--muted); }
  .plan-price .period { font-size: 0.82rem; font-weight: 400; color: var(--muted); }
  .plan-sub { font-size: 0.78rem; color: var(--muted); margin-bottom: 24px; min-height: 18px; }

  .plan-features { list-style: none; padding: 0; margin: 0 0 28px; flex: 1; }
  .plan-features li { padding: 5px 0; color: var(--muted); font-size: 0.82rem; display: flex; align-items: flex-start; gap: 8px; line-height: 1.4; }
  .plan-features li::before { content: '\2713'; color: var(--green); font-weight: 700; flex-shrink: 0; margin-top: 1px; }
  .plan-features li.dim::before { content: '\2013'; color: #444; }
  .plan-features li.dim { color: #555; }

  .plan-cta { display: block; text-align: center; padding: 11px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.88rem; cursor: pointer; font-family: 'Inter', sans-serif; transition: transform 0.2s, box-shadow 0.2s; border: none; }
  .plan-cta.primary { background: var(--accent); color: var(--bg); }
  .plan-cta.primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(34,211,238,0.3); }
  .plan-cta.secondary { background: transparent; border: 1px solid var(--border); color: var(--fg); }
  .plan-cta.secondary:hover { border-color: var(--muted); }
  .plan-cta.outline { background: transparent; border: 1px solid var(--accent); color: var(--accent); }
  .plan-cta.outline:hover { background: rgba(34,211,238,0.08); }

  .faq { max-width: 640px; margin: 0 auto 80px; }
  .faq h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 28px; text-align: center; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 18px 0; }
  .faq-q { font-size: 0.92rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
  .faq-q::after { content: '+'; color: var(--muted); font-size: 1.2rem; transition: transform 0.2s; }
  .faq-item.open .faq-q::after { transform: rotate(45deg); }
  .faq-a { color: var(--muted); font-size: 0.85rem; line-height: 1.6; max-height: 0; overflow: hidden; transition: max-height 0.3s, padding 0.3s; }
  .faq-item.open .faq-a { max-height: 200px; padding-top: 12px; }

  footer { border-top: 1px solid var(--border); padding: 32px; text-align: center; color: var(--muted); font-size: 0.78rem; }
  footer a { color: var(--accent); text-decoration: none; }
</style>

<nav>
  <a href="/" class="brand">savants<span>.dev</span></a>
  <div class="links">
    <a href="/">Home</a>
    <a href="/pricing" style="color: var(--fg);">Pricing</a>
    <a href="/install">Install</a>
    <a href="/cloud" class="nav-cta">Sign in</a>
  </div>
</nav>

<div class="pricing-page">
  <div class="pricing-header">
    <h1>Simple pricing, no surprises</h1>
    <p>Local tools are free forever. Cloud plans scale with your infrastructure - not your API calls.</p>
  </div>

  <div class="plans">
    <!-- Free -->
    <div class="plan">
      <div class="plan-tier">Free</div>
      <div class="plan-price"><span class="currency">$</span>0</div>
      <div class="plan-sub">Free forever</div>
      <ul class="plan-features">
        <li>14 local MCP tools</li>
        <li>Semantic code search</li>
        <li>File skeleton, callers, where_used</li>
        <li>Blast radius, dead code</li>
        <li>Works offline</li>
        <li class="dim">No cloud tools</li>
        <li class="dim">No integrations</li>
        <li class="dim">No agent monitoring</li>
      </ul>
      <a href="/install" class="plan-cta secondary">Install free</a>
    </div>

    <!-- Starter -->
    <div class="plan">
      <div class="plan-tier">Starter</div>
      <div class="plan-price"><span class="currency">$</span>499<span class="period">/mo</span></div>
      <div class="plan-sub">For small teams and startups</div>
      <ul class="plan-features">
        <li>Everything in Free</li>
        <li>All 86+ cloud tools</li>
        <li>10,000 graph nodes</li>
        <li>1 infrastructure agent</li>
        <li>1 K8s cluster</li>
        <li>10 team members</li>
        <li>7-day history</li>
        <li>Sentry + GitHub + Slack</li>
        <li>Email support</li>
      </ul>
      <button class="plan-cta primary" onclick="checkout('starter')">Start Starter</button>
    </div>

    <!-- Pro -->
    <div class="plan featured">
      <div class="plan-tier">Pro</div>
      <div class="plan-price"><span class="currency">$</span>2,999<span class="period">/mo</span></div>
      <div class="plan-sub">For growing engineering orgs</div>
      <ul class="plan-features">
        <li>Everything in Starter</li>
        <li>100,000 graph nodes</li>
        <li>5 infrastructure agents</li>
        <li>3 K8s clusters</li>
        <li>50 team members</li>
        <li>90-day history</li>
        <li>AWS + GCP integration</li>
        <li>9 eBPF kernel probes</li>
        <li>PR auto-comments</li>
        <li>Priority support</li>
      </ul>
      <button class="plan-cta primary" onclick="checkout('pro')">Start Pro</button>
    </div>

    <!-- Enterprise -->
    <div class="plan">
      <div class="plan-tier">Enterprise</div>
      <div class="plan-price"><span class="currency">$</span>9,999<span class="period">+/mo</span></div>
      <div class="plan-sub">For large teams with compliance needs</div>
      <ul class="plan-features">
        <li>Everything in Pro</li>
        <li>Unlimited graph nodes</li>
        <li>Unlimited agents + clusters</li>
        <li>Unlimited users</li>
        <li>1-year history</li>
        <li>SSO / SAML</li>
        <li>Dedicated support + SLA</li>
        <li>Custom integrations</li>
        <li>On-prem deployment</li>
      </ul>
      <a href="mailto:sales@savants.dev?subject=Enterprise%20inquiry" class="plan-cta outline">Contact sales</a>
    </div>
  </div>

  <!-- FAQ -->
  <div class="faq">
    <h2>Questions</h2>
    <div class="faq-item">
      <div class="faq-q">What are graph nodes?</div>
      <div class="faq-a">Every function, class, module, pod, service, and integration endpoint in your codebase is a graph node. A typical 50K-line repo has ~5,000 nodes. Monorepos and microservices have the same node count as separate repos - you can't game it.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">What are the 9 eBPF probes?</div>
      <div class="faq-a">Real-time kernel tracing: TCP retransmits, block I/O latency, CPU scheduler queue latency, kernel packet drops, OOM kills, process execution, TCP connection lifecycle, TCP resets, and Linux capability checks. These run in-kernel with near-zero overhead.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Are tool calls limited?</div>
      <div class="faq-a">No. All tools are unlimited within your tier. You pay for infrastructure footprint (nodes, agents, users), not per API call. Run diagnose_error 1,000 times a day - no extra charge.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Can I try before I buy?</div>
      <div class="faq-a">Yes. The local tools are completely free with no account needed. Install with curl savants.sh | sh and start querying your codebase immediately. Cloud features require a paid plan.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">What integrations are included?</div>
      <div class="faq-a">Starter includes Sentry, GitHub, Linear, Slack, and Cloudflare. Pro adds AWS and GCP. Enterprise includes custom integrations. All tiers get unlimited tool calls to connected services.</div>
    </div>
    <div class="faq-item">
      <div class="faq-q">Do you store my source code?</div>
      <div class="faq-a">No. Savants only stores metadata - function signatures, call graphs, file paths, and line numbers. Your actual source code never leaves your machine. Verifiable with a packet capture.</div>
    </div>
  </div>
</div>

<footer>
  &copy; 2026 Savants &middot; <a href="/privacy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot; <a href="mailto:hello@savants.dev">Contact</a>
</footer>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-q').forEach(q => {
    q.addEventListener('click', () => q.parentElement.classList.toggle('open'));
  });

  // Checkout
  async function checkout(plan) {
    const token = document.cookie.match(/(?:^|;\s*)savants_token=([^;]*)/)?.[1]
      || localStorage.getItem('savants_token');

    if (!token) {
      window.location.href = '/cloud?redirect=/pricing&plan=' + plan;
      return;
    }

    try {
      const res = await fetch('https://api.savants.cloud/api/v1/billing/checkout', {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan, success_url: window.location.origin + '/dashboard?checkout=success', cancel_url: window.location.origin + '/pricing' }),
      });
      const data = await res.json();
      if (data.checkout_url) window.location.href = data.checkout_url;
      else if (data.url) window.location.href = data.url;
      else alert(data.error || data.message || 'Failed to start checkout');
    } catch (e) {
      alert('Failed to connect: ' + e.message);
    }
  }
</script>
</Base>
