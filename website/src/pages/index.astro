<script>
  // ---- Scroll progress indicator ----
  const scrollProgress = document.getElementById('scroll-progress');
  function updateScrollProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (docHeight > 0 && scrollProgress) {
      scrollProgress.style.width = (scrollTop / docHeight * 100) + '%';
    }
  }
  window.addEventListener('scroll', updateScrollProgress, { passive: true });

  // ---- Nav opacity on scroll ----
  const mainNav = document.getElementById('main-nav');
  function updateNav() {
    if (mainNav) {
      if (window.scrollY > 100) {
        mainNav.classList.add('scrolled');
      } else {
        mainNav.classList.remove('scrolled');
      }
    }
  }
  window.addEventListener('scroll', updateNav, { passive: true });

  // ---- Create floating particles ----
  const particleContainer = document.getElementById('hero-particles');
  if (particleContainer) {
    for (let i = 0; i < 30; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.animationDuration = (8 + Math.random() * 12) + 's';
      p.style.animationDelay = (Math.random() * 10) + 's';
      p.style.width = (1 + Math.random() * 2) + 'px';
      p.style.height = p.style.width;
      particleContainer.appendChild(p);
    }
  }

  // ---- Mobile hamburger toggle ----
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');
  if (hamburger && navLinks) {
    hamburger.addEventListener('click', () => {
      navLinks.classList.toggle('open');
    });
    navLinks.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => navLinks.classList.remove('open'));
    });
  }

  // ---- Copy install command ----
  const box = document.getElementById('install-box');
  const hint = document.getElementById('copy-hint');
  if (box && hint) {
    box.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('curl -fsSL savants.sh | sh');
        hint.textContent = 'copied!';
        setTimeout(() => { hint.textContent = 'click to copy'; }, 2000);
      } catch {}
    });
  }

  // ---- Smooth scroll for anchor links ----
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const target = document.querySelector((a as HTMLAnchorElement).getAttribute('href') || '');
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  // ---- Magnetic button effect on CTA ----
  const ctaBtn = document.getElementById('cta-btn');
  if (ctaBtn) {
    ctaBtn.addEventListener('mousemove', (e) => {
      const rect = ctaBtn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      ctaBtn.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px)`;
    });
    ctaBtn.addEventListener('mouseleave', () => {
      ctaBtn.style.transform = '';
    });
  }

  // ---- GSAP Animations ----
  function initGSAP() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(initGSAP, 50);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    // Character splitter utility
    function splitChars(el: HTMLElement) {
      el.innerHTML = el.textContent!.split('').map(c =>
        c === ' ' ? ' ' : '<span class="char">' + c + '</span>'
      ).join('');
      return el.querySelectorAll('.char');
    }

    // ---- HERO: Ken Burns zoom on video ----
    const heroVideo = document.querySelector('.hero-bg video') as HTMLElement;
    if (heroVideo) {
      gsap.fromTo(heroVideo,
        { scale: 1.0 },
        { scale: 1.1, duration: 20, repeat: -1, yoyo: true, ease: 'none' }
      );
    }

    // ---- HERO: Headline with elastic stagger ----
    const heroH1 = document.getElementById('hero-headline');
    if (heroH1) {
      const chars = splitChars(heroH1);
      gsap.from(chars, {
        opacity: 0,
        y: 40,
        rotateX: -90,
        duration: 0.6,
        stagger: 0.025,
        ease: 'elastic.out(1, 0.5)',
        delay: 0.5
      });
    }

    // ---- HERO: Subtitle and install box with snap ----
    gsap.utils.toArray('.hero .gs-up').forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: i === 1 ? 'back.out(2)' : 'power2.out',
        delay: 1.4 + i * 0.2
      });
    });

    // ---- TERMINAL: 3D perspective tilt that flattens ----
    const termSection = document.getElementById('terminal-section');
    if (termSection) {
      gsap.set(termSection, { rotateX: 3, transformPerspective: 1200 });
      gsap.to(termSection, {
        opacity: 1,
        y: 0,
        rotateX: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: termSection,
          start: 'top 85%',
          end: 'top 40%',
          scrub: true
        }
      });

      // Lines appear as if typed
      const lines = document.querySelectorAll('#term .line');
      lines.forEach((line, i) => {
        gsap.to(line, {
          opacity: 1,
          y: 0,
          duration: 0.2,
          delay: i * 0.18,
          ease: 'power1.out',
          scrollTrigger: {
            trigger: termSection,
            start: 'top 70%',
            once: true
          }
        });
      });
    }

    // ---- COMPARISON: Cards slide in ----
    const beforeCard = document.getElementById('card-before');
    const afterCard = document.getElementById('card-after');
    if (beforeCard) {
      gsap.to(beforeCard, {
        opacity: 1,
        x: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: { trigger: '.comparison', start: 'top 70%', once: true },
        onComplete: () => {
          // Shake animation
          beforeCard.classList.add('shake');
          setTimeout(() => beforeCard.classList.remove('shake'), 600);
        }
      });
    }
    if (afterCard) {
      gsap.to(afterCard, {
        opacity: 1,
        x: 0,
        duration: 0.8,
        ease: 'power2.out',
        scrollTrigger: { trigger: '.comparison', start: 'top 70%', once: true },
        onComplete: () => {
          afterCard.classList.add('glow-pulse');
        }
      });
    }

    // ---- COMPARISON: Counter animations ----
    const counterBefore = document.getElementById('counter-before');
    const counterAfter = document.getElementById('counter-after');
    if (counterBefore) {
      const proxy = { val: 0 };
      gsap.to(proxy, {
        val: 47,
        duration: 2.5,
        ease: 'power1.in',
        snap: { val: 1 },
        scrollTrigger: { trigger: '.comparison', start: 'top 70%', once: true },
        onUpdate: () => {
          counterBefore.textContent = Math.round(proxy.val) + ' min';
          // Red glow intensifies
          const intensity = proxy.val / 47;
          counterBefore.style.textShadow = `0 0 ${20 * intensity}px rgba(248,113,113,${0.5 * intensity})`;
        }
      });
    }
    if (counterAfter) {
      const proxy = { val: 0 };
      gsap.to(proxy, {
        val: 45,
        duration: 0.6,
        ease: 'power4.out',
        snap: { val: 1 },
        delay: 0.3,
        scrollTrigger: { trigger: '.comparison', start: 'top 70%', once: true },
        onUpdate: () => {
          counterAfter.textContent = Math.round(proxy.val) + ' sec';
        },
        onComplete: () => {
          // Cyan flash
          counterAfter.style.textShadow = '0 0 30px rgba(34,211,238,0.8)';
          gsap.to(counterAfter, { textShadow: '0 0 0px rgba(34,211,238,0)', duration: 1.5 });
        }
      });
    }

    // Comparison heading
    gsap.utils.toArray('.comparison .gs-up').forEach((el: any) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, ease: 'power2.out',
        scrollTrigger: { trigger: '.comparison', start: 'top 75%', once: true }
      });
    });

    // ---- USE CASES: Cards slide up with rotation ----
    gsap.utils.toArray('.uc-card.gs-up').forEach((el: any, i: number) => {
      gsap.fromTo(el,
        { opacity: 0, y: 60, rotateX: 5 },
        {
          opacity: 1, y: 0, rotateX: 0,
          duration: 0.7, delay: i * 0.15, ease: 'power2.out',
          scrollTrigger: { trigger: '.use-cases', start: 'top 75%', once: true }
        }
      );
    });
    // Use cases heading
    gsap.utils.toArray('.use-cases > .gs-up').forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, delay: i * 0.1, ease: 'power2.out',
        scrollTrigger: { trigger: '.use-cases', start: 'top 75%', once: true }
      });
    });

    // ---- CONVERGENCE: Source nodes, lines, center flash ----
    const convVisual = document.getElementById('conv-visual');
    if (convVisual) {
      // Animate source nodes converging
      for (let i = 0; i < 7; i++) {
        const node = document.getElementById('src-' + i);
        if (node) {
          gsap.from(node, {
            scale: 0.5,
            opacity: 0,
            duration: 1,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: '.convergence',
              start: 'top 80%',
              end: 'center center',
              scrub: true,
              once: true
            }
          });
        }
      }
      // Animate SVG lines with animated dashes
      for (let i = 0; i < 7; i++) {
        const line = document.getElementById('line-' + i) as SVGLineElement | null;
        if (line) {
          const length = Math.sqrt(
            Math.pow(parseFloat(line.getAttribute('x2')!) - parseFloat(line.getAttribute('x1')!), 2) +
            Math.pow(parseFloat(line.getAttribute('y2')!) - parseFloat(line.getAttribute('y1')!), 2)
          );
          line.style.strokeDasharray = '6 4';
          line.style.strokeDashoffset = length + '';
          gsap.to(line, {
            strokeDashoffset: 0,
            duration: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: '.convergence',
              start: 'top 80%',
              end: 'center center',
              scrub: true,
              once: true
            }
          });
          // After drawing, animate flowing dashes
          gsap.to(line, {
            strokeDashoffset: -20,
            duration: 1.5,
            repeat: -1,
            ease: 'none',
            delay: 2,
            scrollTrigger: {
              trigger: '.convergence',
              start: 'center center',
              once: true
            }
          });
        }
      }
      // Center node with flash
      const convFlash = document.getElementById('conv-flash');
      gsap.from('.center-node', {
        scale: 0,
        opacity: 0,
        duration: 0.6,
        ease: 'back.out(2)',
        scrollTrigger: {
          trigger: '.convergence',
          start: 'center 60%',
          once: true
        },
        onComplete: () => {
          // Particle burst / flash at center
          if (convFlash) {
            gsap.fromTo(convFlash,
              { opacity: 0.9, scale: 1 },
              { opacity: 0, scale: 8, duration: 0.8, ease: 'power2.out' }
            );
          }
        }
      });
    }

    // Convergence text
    gsap.utils.toArray('.convergence .gs-up').forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, delay: i * 0.1, ease: 'power2.out',
        scrollTrigger: { trigger: '.convergence', start: 'top 80%', once: true }
      });
    });

    // ---- HOW IT WORKS: Step circles bounce ----
    ['step-1', 'step-2', 'step-3'].forEach((id, i) => {
      const el = document.getElementById(id);
      if (el) {
        gsap.from(el, {
          scale: 0,
          duration: 0.6,
          delay: i * 0.2,
          ease: 'bounce.out',
          scrollTrigger: { trigger: '.how', start: 'top 75%', once: true }
        });
      }
    });
    gsap.utils.toArray('.how .gs-up').forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, delay: i * 0.15, ease: 'power2.out',
        scrollTrigger: { trigger: '.how', start: 'top 75%', once: true }
      });
    });

    // ---- FEATURES: Grid stagger ----
    gsap.utils.toArray('#features-grid .gs-up').forEach((el: any, i: number) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.5, delay: i * 0.1, ease: 'power2.out',
        scrollTrigger: { trigger: '.features', start: 'top 75%', once: true }
      });
    });
    gsap.utils.toArray('.features > .gs-up').forEach((el: any) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, ease: 'power2.out',
        scrollTrigger: { trigger: '.features', start: 'top 80%', once: true }
      });
    });

    // ---- TRUST: Fade in ----
    const trustSection = document.getElementById('trust');
    if (trustSection) {
      gsap.to(trustSection, {
        opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: trustSection, start: 'top 85%', once: true }
      });
    }

    // ---- PRICING: Cards flip in from back ----
    const priceCards = document.querySelectorAll('.price-card.gs-up');
    priceCards.forEach((el: any, i: number) => {
      gsap.fromTo(el,
        { opacity: 0, rotateY: -90, transformPerspective: 1000 },
        {
          opacity: 1, rotateY: 0,
          duration: 0.8, delay: i * 0.15, ease: 'back.out(1.4)',
          scrollTrigger: { trigger: '.pricing', start: 'top 75%', once: true }
        }
      );
    });

    // ---- PRICING: Price numbers count up ----
    const priceCloudNum = document.getElementById('price-cloud-num');
    if (priceCloudNum) {
      const proxy = { val: 0 };
      gsap.to(proxy, {
        val: 50,
        duration: 1.2,
        ease: 'power2.out',
        snap: { val: 1 },
        scrollTrigger: { trigger: '.pricing', start: 'top 75%', once: true },
        onUpdate: () => {
          priceCloudNum.innerHTML = '$' + Math.round(proxy.val) + '<span style="font-size:1rem;font-weight:400;color:var(--muted)">/mo</span>';
        }
      });
    }

    // Pricing heading
    gsap.utils.toArray('.pricing > .gs-up').forEach((el: any) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.6, ease: 'power2.out',
        scrollTrigger: { trigger: '.pricing', start: 'top 80%', once: true }
      });
    });

    // ---- CTA: Headline with elastic chars ----
    const ctaH2 = document.getElementById('cta-headline');
    if (ctaH2) {
      const inner = ctaH2.querySelector('.cta-gradient-text');
      if (inner) {
        const text = inner.textContent || '';
        inner.innerHTML = text.split('').map(c =>
          c === ' ' ? ' ' : '<span class="char" style="display:inline-block;opacity:0">' + c + '</span>'
        ).join('');
        const chars = inner.querySelectorAll('.char');
        gsap.from(chars, {
          opacity: 0,
          y: 30,
          scale: 0.8,
          duration: 0.5,
          stagger: 0.02,
          ease: 'elastic.out(1, 0.6)',
          scrollTrigger: { trigger: '.cta', start: 'top 75%', once: true }
        });
      }
    }
  }

  initGSAP();
</script>
</Base>
