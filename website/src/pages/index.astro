---
import Base from '../layouts/Base.astro';
---
<Base title="Savants - Your Infrastructure Savant">
<style>
  /* Scroll progress bar */
  .scroll-progress { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: linear-gradient(90deg, var(--accent), #a78bfa, var(--accent)); z-index: 9999; transition: width 0.1s linear; }

  /* Grain overlay */
  .grain-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9998; opacity: 0.03; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); }

  /* Section layout classes */
  .section-wide { width: 100%; padding: 80px 24px; position: relative; }
  .section-contained { width: 100%; max-width: 1000px; margin: 0 auto; padding: 80px 24px; position: relative; }
  .section-inner { max-width: 1000px; margin: 0 auto; }

  /* Gradient dividers between sections */
  .section-divider { width: 100%; height: 1px; background: linear-gradient(90deg, transparent, var(--border), var(--accent-dim), var(--border), transparent); }

  /* Nav */
  nav { position: fixed; top: 3px; left: 0; right: 0; z-index: 100; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); background: rgba(10,10,10,0.6); border-bottom: 1px solid var(--border); transition: background 0.3s ease; }
  nav.scrolled { background: rgba(10,10,10,0.95); }
  nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  nav .brand span { color: var(--accent); }
  nav .links { display: flex; gap: 24px; align-items: center; }
  nav .links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  nav .links a:hover { color: var(--fg); }
  nav .nav-btn { padding: 6px 16px; background: var(--accent); color: var(--bg); font-weight: 600; border-radius: 6px; text-decoration: none; font-size: 0.85rem; transition: transform 0.2s, box-shadow 0.2s; }
  nav .nav-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(34,211,238,0.3); }
  nav .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
  nav .hamburger svg { width: 24px; height: 24px; stroke: var(--fg); }
  @media (max-width: 640px) {
    nav .links { display: none; position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; background: rgba(10,10,10,0.95); backdrop-filter: blur(12px); padding: 16px 24px; gap: 16px; border-bottom: 1px solid var(--border); }
    nav .links.open { display: flex; }
    nav .hamburger { display: block; }
  }

  /* Hero */
  .hero { width: 100%; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; padding: 120px 24px 80px; }
  .hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; overflow: hidden; z-index: 0; }
  .hero-bg video { width: 100%; height: 100%; object-fit: cover; opacity: 0.15; will-change: transform; }
  .hero-bg img.fallback { width: 100%; height: 100%; object-fit: cover; opacity: 0.08; display: none; }
  .hero-content { position: relative; z-index: 2; max-width: 800px; }
  .hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 24px; }
  .hero h1 .char { display: inline-block; opacity: 0; }
  .hero .accent { color: var(--accent); }
  .hero .subtitle { font-size: 1.2rem; color: var(--muted); max-width: 600px; margin: 0 auto 48px; line-height: 1.7; }
  .install-box { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px 28px; display: inline-flex; align-items: center; gap: 12px; margin-bottom: 16px; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; cursor: pointer; }
  .install-box:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(34,211,238,0.1); }
  .install-box code { font-size: 1rem; color: var(--accent); }
  .install-box .copy-hint { color: var(--muted); font-size: 0.75rem; }
  .trust-line { color: var(--muted); font-size: 0.85rem; display: block; margin-top: 8px; }

  /* Floating particles */
  .hero-particles { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; overflow: hidden; }
  .particle { position: absolute; width: 2px; height: 2px; background: var(--accent); border-radius: 50%; opacity: 0; animation: particleFloat linear infinite; }
  @keyframes particleFloat {
    0% { opacity: 0; transform: translateY(100vh) scale(0); }
    10% { opacity: 0.6; }
    90% { opacity: 0.6; }
    100% { opacity: 0; transform: translateY(-100px) scale(1); }
  }

  /* Scroll indicator */
  .scroll-indicator { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .scroll-indicator span { color: var(--muted); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .scroll-chevron { width: 24px; height: 24px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); animation: scrollBounce 2s ease-in-out infinite; }
  @keyframes scrollBounce {
    0%, 100% { transform: rotate(45deg) translateY(0); opacity: 0.5; }
    50% { transform: rotate(45deg) translateY(6px); opacity: 1; }
  }

  /* Terminal */
  .terminal-section { width: 100%; padding: 80px 24px; background: linear-gradient(180deg, transparent 0%, rgba(22,78,99,0.06) 50%, transparent 100%); }
  .terminal-wrap { margin: 0 auto; max-width: 740px; perspective: 1200px; }
  .terminal-bar { background: #1a1a1a; border: 1px solid var(--border); border-bottom: none; border-radius: 12px 12px 0 0; padding: 12px 16px; display: flex; gap: 8px; align-items: center; }
  .terminal-bar .dot { width: 12px; height: 12px; border-radius: 50%; }
  .terminal-bar .dot-r { background: #f87171; }
  .terminal-bar .dot-y { background: #facc15; }
  .terminal-bar .dot-g { background: #4ade80; }
  .terminal-bar .title { color: var(--muted); font-size: 0.75rem; margin-left: 12px; }
  .terminal { background: #0d0d0d; border: 1px solid var(--border); border-top: none; border-radius: 0 0 12px 12px; padding: 24px 28px; text-align: left; overflow-x: auto; font-size: 0.85rem; line-height: 1.8; }
  .terminal .line { opacity: 0; transform: translateY(4px); }
  .terminal .prompt { color: var(--green); }
  .terminal .output { color: var(--muted); }
  .terminal .hl { color: var(--accent); }
  .terminal .warn { color: var(--yellow); text-shadow: 0 0 8px rgba(250,204,21,0.3); }
  .terminal .err { color: var(--red); text-shadow: 0 0 8px rgba(248,113,113,0.3); }
  .terminal .spacer { height: 12px; }
  .terminal-cursor { display: inline-block; width: 8px; height: 16px; background: var(--green); animation: cursorBlink 1s step-end infinite; vertical-align: text-bottom; margin-left: 2px; }
  @keyframes cursorBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  @media (max-width: 640px) { .terminal { font-size: 0.72rem; padding: 16px; } }

  /* Comparison */
  .comparison { width: 100%; padding: 80px 24px; }
  .comparison h2 { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 48px; }
  .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 800px; margin: 0 auto; }
  @media (max-width: 640px) { .compare-grid { grid-template-columns: 1fr; } }
  .compare-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 32px; transition: box-shadow 0.3s; }
  .compare-card.before { border-color: #7f1d1d; }
  .compare-card.after { border-color: #164e63; }
  .compare-card .label { font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; margin-bottom: 16px; }
  .compare-card.before .label { color: var(--red); }
  .compare-card.after .label { color: var(--accent); }
  .compare-card .big { font-size: 3rem; font-weight: 800; margin-bottom: 8px; }
  .compare-card.before .big { color: var(--red); }
  .compare-card.after .big { color: var(--accent); }
  .compare-card p { color: var(--muted); font-size: 0.9rem; }
  .compare-card ul { color: var(--muted); font-size: 0.85rem; list-style: none; padding: 0; margin-top: 16px; }
  .compare-card ul li { padding: 4px 0; }
  .compare-card ul li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; margin-right: 10px; }
  .compare-card.before ul li::before { background: var(--red); }
  .compare-card.after ul li::before { background: var(--accent); }
  @keyframes frustrationShake {
    0%, 100% { transform: translateX(0); }
    10% { transform: translateX(-2px); }
    30% { transform: translateX(2px); }
    50% { transform: translateX(-1px); }
    70% { transform: translateX(1px); }
    90% { transform: translateX(-1px); }
  }
  .compare-card.before.shake { animation: frustrationShake 0.5s ease-in-out; }
  .compare-card.after.glow-pulse { box-shadow: 0 0 30px rgba(34,211,238,0.2), 0 0 60px rgba(34,211,238,0.1); }

  /* Use Cases */
  .use-cases { padding: 80px 24px; }
  .use-cases h2 { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 12px; }
  .use-cases .sub { text-align: center; color: var(--muted); margin-bottom: 48px; font-size: 1rem; }
  .uc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 960px; margin: 0 auto; }
  @media (max-width: 640px) { .uc-grid { grid-template-columns: 1fr; } }
  .uc-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 32px; transition: border-color 0.3s, transform 0.3s; position: relative; overflow: hidden; }
  .uc-card::before { content: ''; position: absolute; inset: 0; border-radius: 12px; padding: 1px; background: linear-gradient(135deg, transparent, transparent); mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; -webkit-mask-composite: xor; pointer-events: none; opacity: 0; transition: opacity 0.3s; }
  .uc-card:hover::before { opacity: 1; background: linear-gradient(135deg, var(--accent), #a78bfa, var(--accent)); }
  .uc-card:hover { transform: translateY(-4px); border-color: transparent; }
  .uc-card .uc-icon { font-size: 1.5rem; margin-bottom: 12px; display: block; }
  .uc-card .uc-cmd { font-size: 0.75rem; color: var(--accent); background: var(--accent-dim); display: inline-block; padding: 2px 8px; border-radius: 4px; margin-bottom: 12px; }
  .uc-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }
  .uc-card .uc-stat { font-size: 1.4rem; font-weight: 800; color: var(--accent); margin-bottom: 8px; }
  .uc-card p { color: var(--muted); font-size: 0.85rem; line-height: 1.6; }

  /* Data Sources Convergence */
  .convergence { width: 100%; padding: 100px 0; text-align: center; position: relative; overflow: hidden; }
  .convergence-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('/graph-viz.png') center/cover no-repeat; opacity: 0.06; pointer-events: none; }
  .convergence h2 { font-size: 2rem; font-weight: 700; margin-bottom: 16px; position: relative; padding: 0 24px; }
  .convergence .sub { color: var(--muted); font-size: 1rem; margin-bottom: 64px; position: relative; padding: 0 24px; }
  .convergence-visual { position: relative; width: 100%; max-width: 600px; height: 400px; margin: 0 auto 48px; }
  .source-node { position: absolute; display: flex; flex-direction: column; align-items: center; gap: 6px; z-index: 2; }
  .source-node .node-circle { width: 48px; height: 48px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: border-color 0.3s, box-shadow 0.3s; }
  .source-node:hover .node-circle { border-color: var(--accent); box-shadow: 0 0 12px rgba(34,211,238,0.2); }
  .source-node .node-label { font-size: 0.7rem; color: var(--muted); font-weight: 500; }
  .center-node { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 3; }
  .center-node .node-circle { width: 72px; height: 72px; border-radius: 50%; background: var(--accent-dim); border: 2px solid var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; color: var(--accent); font-size: 0.65rem; text-align: center; line-height: 1.1; }
  .energy-ring { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 90px; height: 90px; border-radius: 50%; border: 1px solid var(--accent); opacity: 0; animation: energyPulse 2s ease-out infinite; pointer-events: none; }
  .energy-ring:nth-child(2) { animation-delay: 0.7s; }
  .energy-ring:nth-child(3) { animation-delay: 1.4s; }
  @keyframes energyPulse {
    0% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(2.5); }
  }
  .convergence-flash { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 20px; height: 20px; border-radius: 50%; background: var(--accent); opacity: 0; z-index: 4; pointer-events: none; filter: blur(8px); }
  .convergence-tagline { font-size: 1.3rem; font-weight: 700; position: relative; padding: 0 24px; }
  .convergence-tagline .accent { color: var(--accent); }
  .conv-lines { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
  .conv-lines line { stroke: var(--border); stroke-width: 1; }
  @media (max-width: 640px) {
    .convergence-visual { height: 320px; }
    .source-node .node-circle { width: 36px; height: 36px; font-size: 0.9rem; }
    .source-node .node-label { font-size: 0.6rem; }
    .center-node .node-circle { width: 56px; height: 56px; font-size: 0.55rem; }
  }

  /* How */
  .how { padding: 80px 24px; text-align: center; max-width: 1000px; margin: 0 auto; }
  .how h2 { font-size: 2rem; font-weight: 700; margin-bottom: 48px; }
  .steps { display: flex; gap: 48px; justify-content: center; flex-wrap: wrap; }
  .step { flex: 1; min-width: 200px; max-width: 260px; }
  .step .num { display: inline-flex; width: 44px; height: 44px; border-radius: 50%; background: var(--accent-dim); color: var(--accent); font-weight: 700; font-size: 1.1rem; align-items: center; justify-content: center; margin-bottom: 16px; transition: transform 0.2s, box-shadow 0.2s; }
  .step:hover .num { transform: scale(1.1); box-shadow: 0 0 16px rgba(34,211,238,0.3); }
  .step h3 { font-size: 1rem; margin-bottom: 8px; }
  .step p { color: var(--muted); font-size: 0.85rem; }

  /* Features */
  .features { padding: 80px 24px; max-width: 1000px; margin: 0 auto; }
  .features h2 { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 12px; }
  .features .sub { text-align: center; color: var(--muted); margin-bottom: 48px; font-size: 1rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .card:hover { border-color: #404040; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }
  .card p { color: var(--muted); font-size: 0.85rem; line-height: 1.6; }
  .tag { display: inline-block; font-size: 0.65rem; padding: 2px 8px; border-radius: 4px; margin-bottom: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
  .tag-live { background: var(--accent-dim); color: var(--accent); }
  .tag-code { background: #1e1b4b; color: #818cf8; }
  .tag-ai { background: #365314; color: var(--green); }

  /* Trust bar */
  .trust { width: 100%; padding: 48px 24px; text-align: center; }
  .trust p { color: var(--muted); font-size: 0.85rem; margin-bottom: 16px; }
  .trust .badges { display: flex; gap: 32px; justify-content: center; flex-wrap: wrap; }
  .trust .badge { color: #525252; font-size: 0.8rem; font-weight: 500; display: flex; align-items: center; gap: 8px; transition: color 0.2s; }
  .trust .badge:hover { color: var(--muted); }
  .trust .badge .icon { font-size: 1.2rem; }

  /* Pricing */
  .pricing { width: 100%; padding: 80px 24px; }
  .pricing h2 { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 12px; }
  .pricing .sub { text-align: center; color: var(--muted); margin-bottom: 48px; font-size: 1rem; }
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 960px; margin: 0 auto; }
  @media (max-width: 640px) { .pricing-grid { grid-template-columns: 1fr; } }
  .price-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 32px; display: flex; flex-direction: column; transition: transform 0.3s, box-shadow 0.3s; }
  .price-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
  .price-card.featured { border-color: transparent; position: relative; overflow: hidden; }
  .price-card.featured::before { content: ''; position: absolute; inset: 0; border-radius: 12px; padding: 2px; background: linear-gradient(135deg, var(--accent), #a78bfa, #22d3ee, #a78bfa, var(--accent)); background-size: 300% 300%; animation: gradientBorder 4s ease infinite; mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; -webkit-mask-composite: xor; pointer-events: none; }
  @keyframes gradientBorder {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .price-card .tier { font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 8px; }
  .price-card.featured .tier { color: var(--accent); }
  .price-card .price { font-size: 2.5rem; font-weight: 800; margin-bottom: 4px; }
  .price-card.featured .price { color: var(--accent); }
  .price-card .price-sub { color: var(--muted); font-size: 0.8rem; margin-bottom: 24px; }
  .price-card ul { list-style: none; padding: 0; margin: 0 0 24px; flex: 1; }
  .price-card ul li { padding: 6px 0; color: var(--muted); font-size: 0.85rem; display: flex; align-items: flex-start; gap: 8px; }
  .price-card ul li::before { content: '\2713'; color: var(--green); font-weight: 700; flex-shrink: 0; }
  .price-card .price-btn { display: block; text-align: center; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s; }
  .price-card .price-btn.primary { background: var(--accent); color: var(--bg); }
  .price-card .price-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(34,211,238,0.3); }
  .price-card .price-btn.secondary { border: 1px solid var(--border); color: var(--fg); }
  .price-card .price-btn.secondary:hover { border-color: var(--muted); }
  .price-card .price-btn:hover { opacity: 0.85; }

  /* CTA */
  .cta { width: 100%; padding: 100px 24px 120px; text-align: center; position: relative; overflow: hidden; }
  .cta-aurora { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .cta-aurora::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(ellipse at 30% 50%, rgba(34,211,238,0.06) 0%, transparent 50%), radial-gradient(ellipse at 70% 50%, rgba(167,139,250,0.04) 0%, transparent 50%); animation: auroraShift 8s ease-in-out infinite alternate; }
  @keyframes auroraShift {
    0% { transform: translateX(-5%) translateY(-5%) rotate(0deg); }
    100% { transform: translateX(5%) translateY(5%) rotate(3deg); }
  }
  .cta h2 { font-size: clamp(2rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: 16px; letter-spacing: -0.02em; position: relative; z-index: 1; }
  .cta h2 .char { display: inline-block; opacity: 0; }
  .cta-gradient-text { background: linear-gradient(90deg, var(--accent), #a78bfa, var(--accent)); background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradientTextShift 6s ease infinite; }
  @keyframes gradientTextShift {
    0% { background-position: 0% center; }
    50% { background-position: 100% center; }
    100% { background-position: 0% center; }
  }
  .cta p { color: var(--muted); margin-bottom: 32px; font-size: 1.1rem; position: relative; z-index: 1; }
  .cta .btn-wrap { position: relative; z-index: 1; }
  .btn { display: inline-block; padding: 14px 36px; background: var(--accent); color: var(--bg); font-weight: 600; border-radius: 8px; text-decoration: none; font-size: 1rem; transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s; }
  .btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(34,211,238,0.3); }
  .btn-ghost { display: inline-block; padding: 14px 36px; border: 1px solid var(--border); color: var(--fg); font-weight: 500; border-radius: 8px; text-decoration: none; font-size: 1rem; margin-left: 12px; transition: border-color 0.2s, transform 0.2s; }
  .btn-ghost:hover { border-color: var(--muted); transform: translateY(-1px); }
  @keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(34,211,238,0.3); } 50% { box-shadow: 0 0 0 8px rgba(34,211,238,0); } }
  .btn-pulse { animation: pulse 2.5s ease-in-out infinite; }
  .magnetic-btn { transition: transform 0.15s ease-out; }

  /* Footer */
  footer { border-top: 1px solid var(--border); padding: 32px 24px; text-align: center; color: var(--muted); font-size: 0.85rem; }
  footer a { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
  footer a:hover { opacity: 0.8; }
  footer .patent { display: block; margin-top: 8px; font-size: 0.75rem; color: #525252; }
</style>

<!-- Scroll progress indicator -->
<div class="scroll-progress" id="scroll-progress"></div>

<!-- Grain texture overlay -->
<div class="grain-overlay"></div>

