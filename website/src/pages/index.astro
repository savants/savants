<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
  // ------ Hamburger menu ------
  document.getElementById('hamburgerBtn')?.addEventListener('click', () => {
    document.getElementById('navLinks')?.classList.toggle('open');
  });

  // ------ Copy install command ------
  document.getElementById('installBox')?.addEventListener('click', () => {
    navigator.clipboard.writeText('curl -fsSL savants.sh | sh').then(() => {
      const toast = document.getElementById('copiedToast');
      if (toast) { toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 1200); }
    });
  });

  // ------ Scroll progress + nav scroll state ------
  const nav = document.getElementById('mainNav');
  const progressBar = document.getElementById('scrollProgress');
  window.addEventListener('scroll', () => {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (progressBar && docHeight > 0) {
      progressBar.style.width = (scrollTop / docHeight * 100) + '%';
    }
    if (nav) {
      nav.classList.toggle('scrolled', scrollTop > 40);
    }
  }, { passive: true });

  // ------ GSAP Animations ------
  function initGSAP() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;

    gsap.registerPlugin(ScrollTrigger);
    document.body.classList.add('gsap-ready');

    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    // --- Hero dot grid parallax (desktop only) ---
    if (!isMobile) {
      gsap.to('#dotGrid', {
        y: () => window.innerHeight * 0.3,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }

    // --- Generic reveal for gs-up elements ---
    gsap.utils.toArray('.gs-up').forEach((el) => {
      gsap.to(el, {
        opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%', toggleActions: 'play none none none' }
      });
    });

    // --- Problem terminals parallax (desktop only) ---
    if (!isMobile) {
      gsap.utils.toArray('.gs-left').forEach((el) => {
        gsap.to(el, {
          opacity: 1, x: 0, duration: 0.9, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' }
        });
      });
      gsap.utils.toArray('.gs-right').forEach((el) => {
        gsap.to(el, {
          opacity: 1, x: 0, duration: 0.9, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' }
        });
      });

      // Parallax differential speed on the two terminal cards
      gsap.to('#termLeft', {
        y: -40,
        ease: 'none',
        scrollTrigger: {
          trigger: '.problem',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true
        }
      });
      gsap.to('#termRight', {
        y: 40,
        ease: 'none',
        scrollTrigger: {
          trigger: '.problem',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true
        }
      });
    } else {
      // Mobile: just fade in
      gsap.utils.toArray('.gs-left, .gs-right').forEach((el) => {
        gsap.to(el, {
          opacity: 1, x: 0, duration: 0.6, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 90%', toggleActions: 'play none none none' }
        });
      });
    }

    // --- Step cards stagger ---
    gsap.utils.toArray('.step-card').forEach((card) => {
      const stagger = parseInt(card.getAttribute('data-stagger') || '0');
      gsap.to(card, {
        opacity: 1, y: 0, duration: 0.8, delay: stagger * 0.15,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.how-grid', start: 'top 85%', toggleActions: 'play none none none' }
      });
    });

    // --- Tool rows stagger ---
    gsap.utils.toArray('.tool-row').forEach((row, i) => {
      gsap.to(row, {
        opacity: 1, y: 0, duration: 0.6, delay: i * 0.1,
        ease: 'power2.out',
        scrollTrigger: { trigger: row, start: 'top 92%', toggleActions: 'play none none none' }
      });
    });

    // --- Number count-up ---
    const numEls = document.querySelectorAll('.num-value[data-target]');
    numEls.forEach((el) => {
      const target = parseInt(el.getAttribute('data-target') || '0');
      const prefix = el.getAttribute('data-prefix') || '';
      const suffix = el.getAttribute('data-suffix') || '';
      const isZero = el.getAttribute('data-is-zero') === 'true';

      if (isZero) {
        el.textContent = '0';
        return;
      }

      const obj = { val: 0 };
      gsap.to(obj, {
        val: target,
        duration: 1.6,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 90%',
          toggleActions: 'play none none none'
        },
        onUpdate: () => {
          el.textContent = prefix + Math.round(obj.val) + suffix;
        }
      });
    });
  }

  // Wait for GSAP to load (it's deferred)
  function waitForGSAP() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      initGSAP();
    } else {
      setTimeout(waitForGSAP, 50);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', waitForGSAP);
  } else {
    waitForGSAP();
  }

  // ------ Mouse glow + aurora reactivity ------
  const mouseGlow = document.getElementById('mouseGlow');
  const heroAurora = document.getElementById('heroAurora');
  let mouseX = 0, mouseY = 0;

  document.addEventListener('mousemove', (e) => {
    mouseX = e.clientX; mouseY = e.clientY;
    if (mouseGlow) {
      mouseGlow.style.left = mouseX + 'px';
      mouseGlow.style.top = mouseY + 'px';
      if (!mouseGlow.classList.contains('active')) mouseGlow.classList.add('active');
    }
    // Aurora follows mouse slightly
    if (heroAurora) {
      const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
      const dx = (mouseX - cx) / cx * 15;
      const dy = (mouseY - cy) / cy * 15;
      heroAurora.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px))`;
    }
  });

  document.addEventListener('mouseleave', () => {
    if (mouseGlow) mouseGlow.classList.remove('active');
  });

  // ------ Constellation particle network + shooting stars ------
  (function() {
    const canvas = document.getElementById('constellation');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    let w, h, particles = [], shootingStars = [];
    const PARTICLE_COUNT = 70;
    const CONNECT_DIST = 160;
    const MOUSE_DIST = 220;

    function resize() {
      const hero = canvas.parentElement;
      w = canvas.width = hero.offsetWidth;
      h = canvas.height = hero.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    // Create particles with organic drift
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.2 + Math.random() * 0.5;
      particles.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        r: Math.random() * 2 + 0.8,
        color: Math.random() > 0.5 ? 'rgba(34,211,238,' : 'rgba(167,139,250,',
        pulse: Math.random() * Math.PI * 2,
        pulseSpeed: 0.02 + Math.random() * 0.03
      });
    }

    // Spawn a shooting star
    function spawnShootingStar() {
      const fromLeft = Math.random() > 0.3;
      const angle = (fromLeft ? -0.3 : -2.8) + Math.random() * 0.4;
      const speed = 8 + Math.random() * 12;
      const isCyan = Math.random() > 0.4;
      shootingStars.push({
        x: fromLeft ? Math.random() * w * 0.6 : w * 0.4 + Math.random() * w * 0.6,
        y: -10 + Math.random() * h * 0.3,
        vx: Math.cos(angle) * speed,
        vy: -Math.sin(angle) * speed,
        life: 1,
        decay: 0.015 + Math.random() * 0.01,
        length: 60 + Math.random() * 80,
        width: 1 + Math.random() * 1.5,
        r: isCyan ? 34 : 167,
        g: isCyan ? 211 : 139,
        b: isCyan ? 238 : 250
      });
    }

    // Schedule shooting stars at random intervals
    function scheduleNext() {
      const delay = 1500 + Math.random() * 4000;
      setTimeout(() => { spawnShootingStar(); scheduleNext(); }, delay);
    }
    scheduleNext();
    // Start with a couple
    spawnShootingStar();
    setTimeout(spawnShootingStar, 800);

    let time = 0;

    function draw() {
      ctx.clearRect(0, 0, w, h);
      time++;

      const rect = canvas.getBoundingClientRect();
      const mx = mouseX - rect.left;
      const my = mouseY - rect.top;

      // --- Draw shooting stars ---
      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const s = shootingStars[i];
        s.x += s.vx;
        s.y += s.vy;
        s.life -= s.decay;

        if (s.life <= 0 || s.x < -100 || s.x > w + 100 || s.y > h + 100) {
          shootingStars.splice(i, 1);
          continue;
        }

        // Trail
        const tailX = s.x - (s.vx / Math.sqrt(s.vx*s.vx + s.vy*s.vy)) * s.length * s.life;
        const tailY = s.y - (s.vy / Math.sqrt(s.vx*s.vx + s.vy*s.vy)) * s.length * s.life;

        const grad = ctx.createLinearGradient(s.x, s.y, tailX, tailY);
        grad.addColorStop(0, `rgba(${s.r},${s.g},${s.b},${s.life * 0.8})`);
        grad.addColorStop(0.3, `rgba(${s.r},${s.g},${s.b},${s.life * 0.3})`);
        grad.addColorStop(1, `rgba(${s.r},${s.g},${s.b},0)`);

        ctx.beginPath();
        ctx.moveTo(s.x, s.y);
        ctx.lineTo(tailX, tailY);
        ctx.strokeStyle = grad;
        ctx.lineWidth = s.width * s.life;
        ctx.lineCap = 'round';
        ctx.stroke();

        // Bright head
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.width * s.life * 1.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${s.life * 0.6})`;
        ctx.fill();

        // Head glow
        ctx.beginPath();
        ctx.arc(s.x, s.y, 6 * s.life, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${s.r},${s.g},${s.b},${s.life * 0.2})`;
        ctx.fill();
      }

      // --- Draw constellation particles ---
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        // Pulsing size
        p.pulse += p.pulseSpeed;
        const pr = p.r * (0.8 + Math.sin(p.pulse) * 0.3);

        // Gentle organic drift (sine wave wobble)
        p.vx += Math.sin(time * 0.005 + i) * 0.003;
        p.vy += Math.cos(time * 0.004 + i * 1.3) * 0.003;

        // Mouse attraction
        const dmx = mx - p.x, dmy = my - p.y;
        const dm = Math.sqrt(dmx * dmx + dmy * dmy);
        if (dm < MOUSE_DIST && dm > 0) {
          p.vx += dmx / dm * 0.03;
          p.vy += dmy / dm * 0.03;
        }

        // Speed limit
        const spd = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (spd > 1.2) { p.vx *= 1.2 / spd; p.vy *= 1.2 / spd; }

        p.x += p.vx;
        p.y += p.vy;

        // Damping
        p.vx *= 0.995;
        p.vy *= 0.995;

        // Wrap edges
        if (p.x < -20) p.x = w + 20;
        if (p.x > w + 20) p.x = -20;
        if (p.y < -20) p.y = h + 20;
        if (p.y > h + 20) p.y = -20;

        // Draw particle with glow
        ctx.beginPath();
        ctx.arc(p.x, p.y, pr + 3, 0, Math.PI * 2);
        ctx.fillStyle = p.color + '0.08)';
        ctx.fill();

        ctx.beginPath();
        ctx.arc(p.x, p.y, pr, 0, Math.PI * 2);
        ctx.fillStyle = p.color + '0.6)';
        ctx.fill();

        // Connect nearby particles
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const dx = p.x - q.x, dy = p.y - q.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < CONNECT_DIST) {
            const alpha = (1 - dist / CONNECT_DIST) * 0.18;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.strokeStyle = p.color + alpha + ')';
            ctx.lineWidth = 0.6;
            ctx.stroke();
          }
        }

        // Connect to mouse
        if (dm < MOUSE_DIST) {
          const alpha = (1 - dm / MOUSE_DIST) * 0.3;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(mx, my);
          ctx.strokeStyle = 'rgba(34,211,238,' + alpha + ')';
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }

      requestAnimationFrame(draw);
    }
    draw();
  })();
</script>
</Base>
