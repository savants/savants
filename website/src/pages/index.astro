---
import Base from '../layouts/Base.astro';
---
<Base title="Savants - Your AI agent just got 10x smarter">
<style>
  /* ============================================================
     GLOBAL PAGE STYLES
     Apple product page meets Linear motion design.
     ============================================================ */

  /* Scroll progress */
  .scroll-progress {
    position: fixed; top: 0; left: 0; width: 0%; height: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent));
    z-index: 9999; transition: width 0.08s linear;
  }

  /* Nav */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 18px 32px; display: flex; justify-content: space-between;
    align-items: center; backdrop-filter: blur(16px);
    background: rgba(10,10,10,0.5); border-bottom: 1px solid transparent;
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  nav.scrolled { background: rgba(10,10,10,0.92); border-bottom-color: var(--border); }
  nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; letter-spacing: -0.02em; }
  nav .brand span { color: var(--accent); }
  nav .links { display: flex; gap: 28px; align-items: center; }
  nav .links a { color: var(--muted); text-decoration: none; font-size: 0.88rem; transition: color 0.2s; }
  nav .links a:hover { color: var(--fg); }
  nav .nav-cta {
    padding: 7px 18px; background: linear-gradient(135deg, var(--accent), var(--accent2)); color: var(--bg);
    font-weight: 600; border-radius: 8px; text-decoration: none;
    font-size: 0.85rem; transition: transform 0.2s, box-shadow 0.2s;
  }
  nav .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 20px rgba(34,211,238,0.3), 0 4px 20px rgba(167,139,250,0.2); }
  nav .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
  nav .hamburger svg { width: 24px; height: 24px; stroke: var(--fg); }

  /* ============================================================
     HERO
     ============================================================ */
  .hero {
    width: 100%; min-height: 100vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center; text-align: center;
    position: relative; overflow: hidden; padding: 120px 32px 100px;
  }

  /* Aurora glow orbs - mouse-reactive */
  .hero-aurora {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 140%; height: 140%; pointer-events: none; z-index: 0;
    filter: blur(100px); opacity: 0.18;
    transition: transform 0.3s ease-out;
  }
  .aurora-orb {
    position: absolute; border-radius: 50%;
  }
  .aurora-orb-1 {
    width: 600px; height: 600px; top: 5%; left: 15%;
    background: radial-gradient(circle, #22d3ee 0%, transparent 70%);
    animation: auroraFloat1 6s ease-in-out infinite;
  }
  .aurora-orb-2 {
    width: 500px; height: 500px; top: 25%; right: 10%;
    background: radial-gradient(circle, #a78bfa 0%, transparent 70%);
    animation: auroraFloat2 7s ease-in-out infinite;
  }
  .aurora-orb-3 {
    width: 450px; height: 450px; bottom: 5%; left: 35%;
    background: radial-gradient(circle, #22d3ee 0%, transparent 70%);
    animation: auroraFloat3 9s ease-in-out infinite;
  }
  .aurora-orb-4 {
    width: 350px; height: 350px; top: 40%; left: 5%;
    background: radial-gradient(circle, #7c3aed 0%, transparent 70%);
    animation: auroraFloat2 11s ease-in-out infinite reverse;
  }
  .aurora-orb-5 {
    width: 300px; height: 300px; top: 15%; right: 30%;
    background: radial-gradient(circle, #06b6d4 0%, transparent 70%);
    animation: auroraFloat1 13s ease-in-out infinite reverse;
  }
  @keyframes auroraFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(50px, -40px) scale(1.08); }
    50% { transform: translate(20px, 30px) scale(0.95); }
    75% { transform: translate(-30px, -10px) scale(1.03); }
  }
  @keyframes auroraFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-40px, 50px) scale(0.92); }
    50% { transform: translate(30px, -20px) scale(1.06); }
    75% { transform: translate(-10px, 30px) scale(0.98); }
  }
  @keyframes auroraFloat3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(40px, -50px) scale(1.1); }
    66% { transform: translate(-30px, 20px) scale(0.93); }
  }

  /* Constellation canvas */
  .hero-constellation {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 1;
  }

  /* Mouse glow */
  .mouse-glow {
    position: fixed; width: 400px; height: 400px; border-radius: 50%;
    background: radial-gradient(circle, rgba(34,211,238,0.06) 0%, transparent 70%);
    pointer-events: none; z-index: 0; transform: translate(-50%, -50%);
    transition: opacity 0.3s;
    opacity: 0;
  }
  .mouse-glow.active { opacity: 1; }

  /* Dot grid background */
  .dot-grid {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 1; opacity: 0.04;
    background-image: radial-gradient(circle, var(--fg) 1px, transparent 1px);
    background-size: 32px 32px;
    will-change: transform;
  }

  .hero-content { position: relative; z-index: 2; max-width: 900px; }

  .hero h1 {
    font-size: clamp(3rem, 7vw, 6rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 28px;
    background: linear-gradient(135deg, var(--fg) 0%, #a3a3a3 50%, var(--fg) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 6s ease-in-out infinite;
  }
  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero .subtitle {
    font-size: clamp(1.05rem, 2vw, 1.35rem); color: var(--muted);
    max-width: 560px; margin: 0 auto 56px; line-height: 1.7;
    letter-spacing: -0.01em;
  }
  .hero .subtitle strong { color: var(--accent); font-weight: 600; }

  .install-box {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; padding: 18px 32px; display: inline-flex;
    align-items: center; gap: 14px; cursor: pointer;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    position: relative;
  }
  .install-box:hover {
    border-color: var(--accent); transform: translateY(-2px);
    box-shadow: 0 8px 40px rgba(34,211,238,0.18), 0 0 80px -20px rgba(167,139,250,0.12);
  }
  .install-box code { font-size: 1rem; color: var(--accent); letter-spacing: -0.02em; }
  .install-box .copy-icon {
    color: var(--muted); transition: color 0.2s; flex-shrink: 0;
  }
  .install-box:hover .copy-icon { color: var(--fg); }
  .install-box .copied-toast {
    position: absolute; top: -32px; left: 50%; transform: translateX(-50%);
    background: var(--accent); color: var(--bg); font-size: 0.75rem;
    font-weight: 600; padding: 4px 12px; border-radius: 6px;
    opacity: 0; transition: opacity 0.2s; pointer-events: none;
  }
  .install-box .copied-toast.show { opacity: 1; }

  .trust-line { color: var(--muted); font-size: 0.8rem; margin-top: 16px; display: block; letter-spacing: 0.01em; }

  /* Scroll hint */
  .scroll-hint {
    position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%);
    z-index: 2; display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .scroll-hint span { color: var(--muted); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.15em; }
  .scroll-chevron {
    width: 20px; height: 20px; border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted); transform: rotate(45deg);
    animation: scrollBob 2.5s ease-in-out infinite;
  }
  @keyframes scrollBob {
    0%, 100% { transform: rotate(45deg) translateY(0); opacity: 0.4; }
    50% { transform: rotate(45deg) translateY(5px); opacity: 0.8; }
  }

  /* ============================================================
     THE PROBLEM - parallax terminals
     ============================================================ */
  .problem {
    width: 100%; padding: 140px 32px; position: relative; overflow: hidden;
  }
  .problem-inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: 40px;
  }
  .problem-divider {
    font-size: clamp(0.95rem, 1.8vw, 1.25rem); color: var(--muted);
    text-align: center; max-width: 200px; line-height: 1.6;
    font-style: italic; letter-spacing: -0.01em;
  }
  .problem-divider strong { color: var(--fg); font-style: normal; font-weight: 700; }

  .term-card {
    background: #111; border: 1px solid var(--border); border-radius: 14px;
    overflow: hidden; will-change: transform;
  }
  .term-bar {
    background: #1a1a1a; padding: 10px 16px; display: flex; gap: 7px;
    align-items: center; border-bottom: 1px solid var(--border);
  }
  .term-dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-r { background: #f87171; } .dot-y { background: #facc15; } .dot-g { background: #4ade80; }
  .term-title { font-size: 0.72rem; color: var(--muted); margin-left: 8px; font-family: 'JetBrains Mono', monospace; }
  .term-body {
    padding: 20px; font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem; line-height: 1.7; color: var(--muted);
    min-height: 200px;
  }
  .term-body .cmd { color: var(--green); }
  .term-body .flag { color: var(--yellow); }
  .term-body .result { color: var(--fg); }
  .term-body .dim { color: #555; }
  .term-body .accent { color: var(--accent); }
  .term-body .fail { color: var(--red); }

  /* ============================================================
     NUMBERS - full-bleed cyan accent section
     ============================================================ */
  .numbers {
    width: 100%; padding: 120px 32px; position: relative;
    background: linear-gradient(135deg, var(--accent) 0%, #7c3aed 100%);
    color: var(--bg); text-align: center;
    overflow: hidden;
  }
  .numbers-inner { max-width: 1000px; margin: 0 auto; }
  .numbers-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 48px; margin-bottom: 48px;
  }
  .num-block { display: flex; flex-direction: column; align-items: center; }
  .num-value {
    font-size: clamp(2.8rem, 5vw, 4.5rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 1; margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }
  .num-label { font-size: 0.9rem; opacity: 0.7; font-weight: 500; }
  .numbers .bench-note {
    font-size: 0.85rem; opacity: 0.55; max-width: 500px; margin: 0 auto;
  }

  /* ============================================================
     HOW IT WORKS - 3 step cards
     ============================================================ */
  .how {
    width: 100%; padding: 140px 32px; position: relative;
  }
  .how-inner { max-width: 1000px; margin: 0 auto; }
  .how h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.03em; text-align: center; margin-bottom: 72px;
  }
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }

  .step-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 16px; padding: 40px 32px; position: relative;
    transition: border-color 0.3s, transform 0.3s;
  }
  .step-card:hover {
    border-color: rgba(34,211,238,0.3); transform: translateY(-4px);
    box-shadow: 0 0 40px -10px rgba(34,211,238,0.15), 0 0 80px -20px rgba(167,139,250,0.1);
  }
  .step-icon { margin-bottom: 16px; opacity: 0.9; }
  .step-num {
    font-size: 0.7rem; font-weight: 700; color: var(--accent);
    text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 20px;
    display: block;
  }
  .step-card h3 {
    font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .step-card p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }
  .step-card code {
    display: block; margin-top: 16px; padding: 12px 16px;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; font-size: 0.8rem; color: var(--accent);
  }

  /* ============================================================
     TOOLS - minimal list
     ============================================================ */
  .tools {
    width: 100%; padding: 120px 32px; position: relative;
  }
  .tools-inner { max-width: 800px; margin: 0 auto; }
  .tools h2 {
    font-size: clamp(2rem, 4vw, 3rem); font-weight: 800;
    letter-spacing: -0.03em; margin-bottom: 16px;
  }
  .tools .tools-sub {
    color: var(--muted); font-size: 1.05rem; margin-bottom: 56px;
    max-width: 480px;
  }

  .tool-row {
    display: grid; grid-template-columns: 180px 1fr auto;
    align-items: baseline; padding: 20px 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s;
  }
  .tool-row:first-child { border-top: 1px solid var(--border); }
  .tool-name {
    font-family: 'JetBrains Mono', monospace; font-size: 0.9rem;
    color: var(--accent); font-weight: 500;
  }
  .tool-desc { font-size: 0.9rem; color: var(--muted); }
  .tool-speed {
    font-family: 'JetBrains Mono', monospace; font-size: 0.8rem;
    color: #555; text-align: right;
  }

  /* ============================================================
     CASE STUDY - dark, large type
     ============================================================ */
  .case-study {
    width: 100%; padding: 140px 32px; position: relative;
    background: var(--surface);
  }
  .case-study-inner { max-width: 900px; margin: 0 auto; text-align: center; }
  .case-study .big-number {
    font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800;
    letter-spacing: -0.04em; line-height: 1.1; margin-bottom: 24px;
  }
  .case-study .big-number .accent { color: var(--accent); }
  .case-study p {
    font-size: 1.1rem; color: var(--muted); line-height: 1.7;
    max-width: 560px; margin: 0 auto 40px;
  }
  .case-study .cta-link {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--accent); text-decoration: none; font-weight: 600;
    font-size: 1rem; transition: gap 0.2s;
  }
  .case-study .cta-link:hover { gap: 14px; }
  .case-study .cta-link .arrow { transition: transform 0.2s; }

  /* ============================================================
     CLOUD UPGRADE - subtle
     ============================================================ */
  .cloud {
    width: 100%; padding: 120px 32px; position: relative;
  }
  .cloud-inner { max-width: 800px; margin: 0 auto; }
  .cloud h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 800;
    letter-spacing: -0.03em; margin-bottom: 12px;
  }
  .cloud .cloud-intro {
    font-size: 1.05rem; color: var(--muted); margin-bottom: 48px;
    max-width: 520px; line-height: 1.7;
  }

  .cloud-tools {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
    margin-bottom: 48px;
  }
  .cloud-tool {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 24px 28px;
    transition: border-color 0.3s;
  }
  .cloud-tool:hover {
    border-color: rgba(34,211,238,0.25);
    box-shadow: 0 0 40px -10px rgba(34,211,238,0.12), 0 0 60px -15px rgba(167,139,250,0.08);
  }
  .cloud-tool h4 {
    font-family: 'JetBrains Mono', monospace; font-size: 0.88rem;
    color: var(--accent); margin-bottom: 6px; font-weight: 500;
  }
  .cloud-tool p { font-size: 0.85rem; color: var(--muted); }
  .tool-price {
    font-family: 'Inter', sans-serif; font-size: 0.75rem; font-weight: 600;
    color: var(--accent); background: rgba(34,211,238,0.1);
    padding: 2px 8px; border-radius: 6px; margin-left: 8px;
  }
  .cloud-free-note {
    font-size: 0.9rem; color: var(--muted); margin-top: 32px; margin-bottom: 24px;
  }
  .cloud-free-note a { color: var(--accent); text-decoration: none; font-weight: 600; }

  .cloud .connect-cmd {
    font-family: 'JetBrains Mono', monospace; font-size: 0.9rem;
    color: var(--accent); display: inline-flex; align-items: center;
    gap: 8px; padding: 12px 24px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px;
  }
  .cloud .connect-cmd .prompt { color: var(--muted); }

  /* ============================================================
     WORKS WITH - badges
     ============================================================ */
  .works-with {
    width: 100%; padding: 80px 32px; text-align: center;
  }
  .works-with-inner { max-width: 600px; margin: 0 auto; }
  .works-with h2 {
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--muted); font-weight: 600; margin-bottom: 32px;
  }
  .badge-row { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; }
  .badge {
    padding: 10px 24px; background: var(--surface);
    border: 1px solid var(--border); border-radius: 10px;
    font-size: 0.9rem; font-weight: 500; color: var(--fg);
    transition: border-color 0.2s;
  }
  .badge:hover { border-color: rgba(34,211,238,0.3); }

  /* ============================================================
     FOOTER
     ============================================================ */
  footer {
    width: 100%; padding: 48px 32px; border-top: 1px solid var(--border);
    text-align: center;
  }
  footer .footer-links {
    display: flex; justify-content: center; gap: 32px;
    margin-bottom: 20px; flex-wrap: wrap;
  }
  footer .footer-links a {
    color: var(--muted); text-decoration: none; font-size: 0.85rem;
    transition: color 0.2s;
  }
  footer .footer-links a:hover { color: var(--fg); }
  footer .license { color: #444; font-size: 0.75rem; }

  /* ============================================================
     SECTION DIVIDER
     ============================================================ */
  .section-divider {
    width: 100%; height: 1px; position: relative;
    background: linear-gradient(90deg, transparent, var(--border), transparent);
  }
  .section-divider::after {
    content: ''; position: absolute; top: -1px; left: 25%; width: 50%; height: 3px;
    background: linear-gradient(90deg, transparent, rgba(34,211,238,0.15), rgba(167,139,250,0.15), transparent);
    filter: blur(2px);
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 768px) {
    .hero { min-height: auto; padding: 100px 24px 64px; }
    .hero h1 { font-size: clamp(2.2rem, 8vw, 3.2rem); margin-bottom: 20px; }
    .hero .subtitle { margin-bottom: 36px; }
    .install-box { padding: 14px 20px; }

    .scroll-hint { display: none; }

    .problem { padding: 80px 24px; }
    .problem-inner {
      grid-template-columns: 1fr; gap: 24px; text-align: center;
    }
    .problem-divider { max-width: none; margin: 8px auto; }
    .term-body { min-height: auto; font-size: 0.75rem; padding: 16px; }

    .numbers { padding: 80px 24px; }
    .numbers-grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .num-value { font-size: 2.4rem; }

    .how { padding: 80px 24px; }
    .how h2 { margin-bottom: 40px; }
    .how-grid { grid-template-columns: 1fr; gap: 20px; }
    .step-card { padding: 28px 24px; }

    .tools { padding: 80px 24px; }
    .tool-row { grid-template-columns: 1fr; gap: 4px; padding: 16px 0; }
    .tool-speed { text-align: left; }

    .case-study { padding: 80px 24px; }

    .cloud { padding: 80px 24px; }
    .cloud-tools { grid-template-columns: 1fr; }

    .works-with { padding: 48px 24px; }

    .section-divider { display: none; }

    footer { padding: 32px 24px; }
    footer .footer-links { gap: 20px; }

    nav { padding: 14px 24px; }
    nav .links {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; background: rgba(10,10,10,0.95);
      backdrop-filter: blur(12px); padding: 16px 24px; gap: 16px;
      border-bottom: 1px solid var(--border);
    }
    nav .links.open { display: flex; }
    nav .hamburger { display: block; }
  }
</style>

<!-- Scroll progress bar -->
<div class="scroll-progress" id="scrollProgress"></div>

<!-- Navigation -->
<nav id="mainNav">
  <a href="/" class="brand">savants</a>
  <div class="links" id="navLinks">
    <a href="/case-study">Case Study</a>
    <a href="https://github.com/savants-dev/savants" target="_blank" rel="noopener">GitHub</a>
    <a href="/docs">Docs</a>
    <a href="/cloud" class="nav-cta">Get Started</a>
  </div>
  <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</nav>

<!-- ============================================================
     SECTION 1: HERO
     ============================================================ -->
<div class="mouse-glow" id="mouseGlow"></div>
<section class="hero">
  <div class="hero-aurora" id="heroAurora">
    <div class="aurora-orb aurora-orb-1"></div>
    <div class="aurora-orb aurora-orb-2"></div>
    <div class="aurora-orb aurora-orb-3"></div>
    <div class="aurora-orb aurora-orb-4"></div>
    <div class="aurora-orb aurora-orb-5"></div>
  </div>
  <canvas class="hero-constellation" id="constellation"></canvas>
  <div class="dot-grid" id="dotGrid"></div>
  <div class="hero-content">
    <h1 class="gs-up">Your AI agent just got<br>10x smarter.</h1>
    <p class="subtitle gs-up">Stop watching your AI read 47 files to find one function. Savants gives it <strong>the answer in one call</strong>.</p>
    <div class="install-box gs-up" id="installBox" role="button" tabindex="0" aria-label="Copy install command">
      <code>curl -fsSL savants.sh | sh</code>
      <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
