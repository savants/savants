---
import Base from '../layouts/Base.astro';
---
<Base title="Savants Cloud - Dashboard & API" description="Sign in to Savants Cloud. Manage your context engine, API keys, team members, and usage from one dashboard.">
<style>
  /* Nav */
  nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 16px 24px; display: flex; justify-content: space-between; align-items: center; backdrop-filter: blur(12px); background: rgba(10,10,10,0.8); border-bottom: 1px solid var(--border); }
  nav .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  nav .brand span { color: var(--accent); }
  nav .links { display: flex; gap: 24px; align-items: center; }
  nav .links a { color: var(--muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  nav .links a:hover { color: var(--fg); }

  /* Grain overlay */
  .grain-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9998; opacity: 0.03; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E"); }

  /* Hero / Login area */
  .cloud-hero { width: 100%; min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden; padding: 120px 24px 80px; }
  .cloud-hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
  .cloud-hero-bg::before { content: ''; position: absolute; top: -30%; left: -20%; width: 140%; height: 160%; background: radial-gradient(ellipse at 40% 40%, rgba(34,211,238,0.06) 0%, transparent 55%), radial-gradient(ellipse at 70% 60%, rgba(167,139,250,0.04) 0%, transparent 50%); animation: auroraDrift 12s ease-in-out infinite alternate; }
  @keyframes auroraDrift {
    0% { transform: translateX(-3%) translateY(-2%); }
    100% { transform: translateX(3%) translateY(2%); }
  }

  /* Floating particles */
  .cloud-particles { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; overflow: hidden; }
  .particle { position: absolute; width: 2px; height: 2px; background: var(--accent); border-radius: 50%; opacity: 0; animation: particleFloat linear infinite; }
  @keyframes particleFloat {
    0% { opacity: 0; transform: translateY(100vh) scale(0); }
    10% { opacity: 0.5; }
    90% { opacity: 0.5; }
    100% { opacity: 0; transform: translateY(-100px) scale(1); }
  }

  .cloud-content { position: relative; z-index: 2; max-width: 480px; width: 100%; }
  .cloud-icon { font-size: 2.5rem; margin-bottom: 24px; display: block; }
  .cloud-content h1 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 12px; }
  .cloud-content h1 .accent { color: var(--accent); }
  .cloud-content .subtitle { font-size: 1rem; color: var(--muted); margin-bottom: 40px; line-height: 1.6; }

  /* Login card */
  .login-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 40px 32px; width: 100%; transition: border-color 0.3s; }
  .login-card:hover { border-color: #333; }
  .login-card h2 { font-size: 1.15rem; font-weight: 600; margin-bottom: 24px; }

  .oauth-btn { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; padding: 14px 20px; border-radius: 10px; border: 1px solid var(--border); background: transparent; color: var(--fg); font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 500; cursor: pointer; transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s; text-decoration: none; }
  .oauth-btn:hover { border-color: var(--accent); background: rgba(34,211,238,0.04); transform: translateY(-1px); box-shadow: 0 4px 16px rgba(0,0,0,0.2); }
  .oauth-btn svg { width: 20px; height: 20px; flex-shrink: 0; }
  .oauth-btn + .oauth-btn { margin-top: 12px; }

  .login-divider { display: flex; align-items: center; gap: 16px; margin: 24px 0; }
  .login-divider span { color: var(--muted); font-size: 0.8rem; white-space: nowrap; }
  .login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  .email-input { width: 100%; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--fg); font-family: 'Inter', sans-serif; font-size: 0.95rem; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
  .email-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(34,211,238,0.1); }
  .email-input::placeholder { color: #525252; }

  .email-submit { width: 100%; margin-top: 12px; padding: 14px 20px; border-radius: 10px; border: none; background: var(--accent); color: var(--bg); font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s; }
  .email-submit:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(34,211,238,0.3); }

  .login-footer { margin-top: 20px; font-size: 0.78rem; color: #525252; line-height: 1.5; }
  .login-footer a { color: var(--accent); text-decoration: none; }
  .login-footer a:hover { text-decoration: underline; }

  /* Section divider */
  .section-divider { width: 100%; height: 1px; background: linear-gradient(90deg, transparent, var(--border), var(--accent-dim), var(--border), transparent); }

  /* Dashboard preview */
  .dashboard-preview { width: 100%; padding: 80px 24px; }
  .dashboard-preview h2 { font-size: 2rem; font-weight: 700; text-align: center; margin-bottom: 12px; }
  .dashboard-preview .sub { text-align: center; color: var(--muted); margin-bottom: 48px; font-size: 1rem; }

  .dash-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 900px; margin: 0 auto; }
  @media (max-width: 768px) { .dash-grid { grid-template-columns: 1fr; } }

  .dash-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px; transition: border-color 0.3s, transform 0.3s; }
  .dash-card:hover { border-color: #404040; transform: translateY(-2px); }
  .dash-card .dash-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 16px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .dash-card .dash-label .dash-icon { font-size: 1rem; }

  /* Usage card */
  .usage-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .usage-stat { text-align: center; }
  .usage-stat .val { font-size: 1.8rem; font-weight: 800; color: var(--accent); line-height: 1.2; }
  .usage-stat .label { font-size: 0.75rem; color: var(--muted); margin-top: 4px; }

  .usage-bar { margin-top: 20px; }
  .usage-bar .bar-label { display: flex; justify-content: space-between; font-size: 0.78rem; color: var(--muted); margin-bottom: 6px; }
  .usage-bar .bar-track { height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
  .usage-bar .bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--accent), #a78bfa); transition: width 1.5s ease; }

  /* API keys card */
  .api-key-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .api-key-row:last-child { border-bottom: none; }
  .api-key-name { font-size: 0.85rem; font-weight: 500; }
  .api-key-value { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--muted); background: var(--bg); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); }
  .api-key-actions { display: flex; gap: 8px; }
  .key-btn { padding: 4px 10px; font-size: 0.72rem; border-radius: 4px; border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; font-family: 'Inter', sans-serif; transition: border-color 0.2s, color 0.2s; }
  .key-btn:hover { border-color: var(--muted); color: var(--fg); }
  .key-btn.danger:hover { border-color: var(--red); color: var(--red); }
  .add-key-btn { margin-top: 16px; padding: 8px 16px; font-size: 0.8rem; border-radius: 6px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-family: 'Inter', sans-serif; width: 100%; transition: border-color 0.2s, background 0.2s; }
  .add-key-btn:hover { border-color: var(--accent); background: rgba(34,211,238,0.04); }

  /* Team card */
  .team-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .team-row:last-child { border-bottom: none; }
  .team-avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; color: var(--accent); flex-shrink: 0; }
  .team-info { flex: 1; }
  .team-name { font-size: 0.85rem; font-weight: 500; }
  .team-role { font-size: 0.72rem; color: var(--muted); }
  .invite-btn { margin-top: 16px; padding: 8px 16px; font-size: 0.8rem; border-radius: 6px; border: 1px dashed var(--border); background: transparent; color: var(--accent); cursor: pointer; font-family: 'Inter', sans-serif; width: 100%; transition: border-color 0.2s, background 0.2s; }
  .invite-btn:hover { border-color: var(--accent); background: rgba(34,211,238,0.04); }

  /* Context engine card */
  .repo-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .repo-row:last-child { border-bottom: none; }
  .repo-name { font-size: 0.85rem; font-weight: 500; display: flex; align-items: center; gap: 8px; }
  .repo-status { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .repo-status.active { background: var(--green); box-shadow: 0 0 6px rgba(74,222,128,0.4); }
  .repo-status.indexing { background: var(--yellow); box-shadow: 0 0 6px rgba(250,204,21,0.4); animation: statusPulse 1.5s ease-in-out infinite; }
  @keyframes statusPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .repo-meta { font-size: 0.72rem; color: var(--muted); text-align: right; }
  .repo-meta .nodes { color: var(--accent); font-weight: 600; }
  .engine-summary { margin-top: 16px; padding: 12px; background: var(--bg); border-radius: 8px; border: 1px solid var(--border); display: flex; justify-content: space-around; text-align: center; }
  .engine-stat .engine-val { font-size: 1.2rem; font-weight: 700; color: var(--accent); }
  .engine-stat .engine-label { font-size: 0.68rem; color: var(--muted); margin-top: 2px; }

  /* Pricing reminder */
  .pricing-reminder { width: 100%; padding: 80px 24px; text-align: center; }
  .pricing-reminder h2 { font-size: 1.8rem; font-weight: 700; margin-bottom: 12px; }
  .pricing-reminder .sub { color: var(--muted); font-size: 1rem; margin-bottom: 48px; max-width: 600px; margin-left: auto; margin-right: auto; }
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-width: 960px; margin: 0 auto; }
  @media (max-width: 640px) { .pricing-grid { grid-template-columns: 1fr; } }
  .price-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 32px; display: flex; flex-direction: column; transition: transform 0.3s, box-shadow 0.3s; }
  .price-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.3); }
  .price-card.featured { border-color: transparent; position: relative; overflow: hidden; }
  .price-card.featured::before { content: ''; position: absolute; inset: 0; border-radius: 12px; padding: 2px; background: linear-gradient(135deg, var(--accent), #a78bfa, #22d3ee, #a78bfa, var(--accent)); background-size: 300% 300%; animation: gradientBorder 4s ease infinite; mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude; -webkit-mask-composite: xor; pointer-events: none; }
  @keyframes gradientBorder {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .price-card .tier { font-size: 0.75rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 8px; }
  .price-card.featured .tier { color: var(--accent); }
  .price-card .price { font-size: 2.5rem; font-weight: 800; margin-bottom: 4px; }
  .price-card.featured .price { color: var(--accent); }
  .price-card .price-sub { color: var(--muted); font-size: 0.8rem; margin-bottom: 24px; }
  .price-card ul { list-style: none; padding: 0; margin: 0 0 24px; flex: 1; }
  .price-card ul li { padding: 6px 0; color: var(--muted); font-size: 0.85rem; display: flex; align-items: flex-start; gap: 8px; }
  .price-card ul li::before { content: '\2713'; color: var(--green); font-weight: 700; flex-shrink: 0; }
  .price-card .price-btn { display: block; text-align: center; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: opacity 0.2s, transform 0.2s, box-shadow 0.2s; }
  .price-card .price-btn.primary { background: var(--accent); color: var(--bg); }
  .price-card .price-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(34,211,238,0.3); }
  .price-card .price-btn.secondary { border: 1px solid var(--border); color: var(--fg); }
  .price-card .price-btn.secondary:hover { border-color: var(--muted); }

  /* Footer */
  footer { border-top: 1px solid var(--border); padding: 32px 24px; text-align: center; color: var(--muted); font-size: 0.85rem; }
  footer a { color: var(--accent); text-decoration: none; transition: opacity 0.2s; }
  footer a:hover { opacity: 0.8; }
  footer .patent { display: block; margin-top: 8px; font-size: 0.75rem; color: #525252; }

  /* Full-width span card */
  .dash-card.full-width { grid-column: 1 / -1; }

  /* GSAP utility */
  .gs-up { opacity: 0; transform: translateY(40px); }
  .gs-scale { opacity: 0; transform: scale(0.95); }
</style>

<!-- Grain texture overlay -->
<div class="grain-overlay"></div>

<!-- Nav -->
<nav>
  <a href="/" class="brand">savants<span>.cloud</span></a>
  <div class="links">
    <a href="https://savants.dev">Home</a>
    <a href="https://docs.savants.dev">Docs</a>
    <a href="#pricing">Pricing</a>
  </div>
</nav>

<!-- Hero / Login -->
<section class="cloud-hero">
  <div class="cloud-hero-bg"></div>
  <div class="cloud-particles" id="cloud-particles"></div>
  <div class="cloud-content">
    <span class="cloud-icon gs-scale">&#9729;</span>
    <h1 class="gs-up">Sign in to <span class="accent">Savants Cloud</span></h1>
    <p class="subtitle gs-up">Manage your context engine, API keys, and team - all from one dashboard.</p>

    <div class="login-card gs-up" id="login-card">
      <h2>Get started</h2>

      <button class="oauth-btn" id="btn-google">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 001 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continue with Google
      </button>

      <button class="oauth-btn" id="btn-github">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        Continue with GitHub
      </button>

      <div class="login-divider"><span>or</span></div>

      <input type="email" class="email-input" placeholder="name@company.com" id="email-input" />
      <button class="email-submit" id="btn-email">Continue with email</button>

      <p class="login-footer">By signing in, you agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</p>
    </div>
  </div>
</section>

<div class="section-divider"></div>

<!-- Dashboard Preview -->
<section class="dashboard-preview" id="dashboard">
  <h2 class="gs-up">Your dashboard at a glance</h2>
  <p class="sub gs-up">Everything you need to manage your Savants Cloud deployment.</p>

  <div class="dash-grid">
    <!-- Usage card -->
    <div class="dash-card gs-up" id="usage-card">
      <div class="dash-label"><span class="dash-icon">&#9888;</span> Usage This Month</div>
      <div class="usage-stats">
        <div class="usage-stat">
          <div class="val" id="stat-calls">0</div>
          <div class="label">API calls</div>
        </div>
        <div class="usage-stat">
          <div class="val" id="stat-cost">$0</div>
          <div class="label">Estimated cost</div>
        </div>
        <div class="usage-stat">
          <div class="val" id="stat-diagnose">0</div>
          <div class="label">diagnose calls</div>
        </div>
        <div class="usage-stat">
          <div class="val" id="stat-query">0</div>
          <div class="label">query calls</div>
        </div>
      </div>
      <div class="usage-bar">
        <div class="bar-label"><span>Budget used</span><span id="budget-pct">0%</span></div>
        <div class="bar-track"><div class="bar-fill" id="budget-bar" style="width: 0%"></div></div>
      </div>
    </div>

    <!-- API Keys card -->
    <div class="dash-card gs-up">
      <div class="dash-label"><span class="dash-icon">&#128273;</span> API Keys</div>
      <div class="api-key-row">
        <div>
          <div class="api-key-name">Production</div>
        </div>
        <div class="api-key-actions">
          <span class="api-key-value">sv_prod_****7f3a</span>
          <button class="key-btn">Copy</button>
          <button class="key-btn danger">Revoke</button>
        </div>
      </div>
      <div class="api-key-row">
        <div>
          <div class="api-key-name">Development</div>
        </div>
        <div class="api-key-actions">
          <span class="api-key-value">sv_dev_****2e91</span>
          <button class="key-btn">Copy</button>
          <button class="key-btn danger">Revoke</button>
        </div>
      </div>
      <div class="api-key-row">
        <div>
          <div class="api-key-name">CI / CD</div>
        </div>
        <div class="api-key-actions">
          <span class="api-key-value">sv_ci_****b40c</span>
          <button class="key-btn">Copy</button>
          <button class="key-btn danger">Revoke</button>
        </div>
      </div>
      <button class="add-key-btn">+ Create new key</button>
    </div>

    <!-- Team card -->
    <div class="dash-card gs-up">
      <div class="dash-label"><span class="dash-icon">&#128101;</span> Team Members</div>
      <div class="team-row">
        <div class="team-avatar">MB</div>
        <div class="team-info">
          <div class="team-name">Miguel Bernadin</div>
          <div class="team-role">Owner</div>
        </div>
      </div>
      <div class="team-row">
        <div class="team-avatar">JD</div>
        <div class="team-info">
          <div class="team-name">Jane Doe</div>
          <div class="team-role">Admin</div>
        </div>
      </div>
      <div class="team-row">
        <div class="team-avatar">AK</div>
        <div class="team-info">
          <div class="team-name">Alex Kim</div>
          <div class="team-role">Member</div>
        </div>
      </div>
      <button class="invite-btn">+ Invite teammate</button>
    </div>

    <!-- Context Engine card -->
    <div class="dash-card gs-up">
      <div class="dash-label"><span class="dash-icon">&#9881;</span> Context Engine</div>
      <div class="repo-row">
        <div class="repo-name"><span class="repo-status active"></span> bernadinm/savants</div>
        <div class="repo-meta"><span class="nodes">27,412</span> nodes<br/>Indexed 2m ago</div>
      </div>
      <div class="repo-row">
        <div class="repo-name"><span class="repo-status active"></span> bernadinm/infra-core</div>
        <div class="repo-meta"><span class="nodes">14,831</span> nodes<br/>Indexed 5m ago</div>
      </div>
      <div class="repo-row">
        <div class="repo-name"><span class="repo-status indexing"></span> bernadinm/frontend-v2</div>
        <div class="repo-meta"><span class="nodes">--</span> nodes<br/>Indexing...</div>
      </div>
      <div class="engine-summary">
        <div class="engine-stat">
