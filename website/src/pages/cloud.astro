  <span class="patent">Patent Pending &middot; &copy; 2026 Savants</span>
</footer>

<script>
  // ---- Floating particles ----
  const particleContainer = document.getElementById('cloud-particles');
  if (particleContainer) {
    for (let i = 0; i < 20; i++) {
      const p = document.createElement('div');
      p.className = 'particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.animationDuration = (10 + Math.random() * 15) + 's';
      p.style.animationDelay = (Math.random() * 8) + 's';
      p.style.width = (1 + Math.random() * 2) + 'px';
      p.style.height = p.style.width;
      particleContainer.appendChild(p);
    }
  }

  // ---- GSAP Animations ----
  function initAnimations() {
    if (typeof gsap === 'undefined') {
      setTimeout(initAnimations, 100);
      return;
    }

    // Hero entrance
    gsap.to('.cloud-icon', { opacity: 1, scale: 1, duration: 0.8, delay: 0.2, ease: 'back.out(1.7)' });

    gsap.utils.toArray('.cloud-content .gs-up').forEach((el, i) => {
      gsap.to(el, { opacity: 1, y: 0, duration: 0.7, delay: 0.3 + i * 0.15, ease: 'power3.out' });
    });

    // Login card special entrance
    gsap.to('#login-card', { opacity: 1, y: 0, duration: 0.8, delay: 0.7, ease: 'power3.out' });

    // Dashboard section - scroll triggered
    if (typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);

      gsap.utils.toArray('.dashboard-preview .gs-up, .pricing-reminder .gs-up').forEach((el, i) => {
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          delay: i * 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            toggleActions: 'play none none none'
          }
        });
      });
    }

    // Animate usage numbers
    function animateCounter(id, target, prefix, suffix) {
      const el = document.getElementById(id);
      if (!el) return;
      const obj = { val: 0 };
      gsap.to(obj, {
        val: target,
        duration: 2,
        delay: 0.5,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '#usage-card',
          start: 'top 80%',
          toggleActions: 'play none none none'
        },
        onUpdate: () => {
          el.textContent = (prefix || '') + Math.round(obj.val).toLocaleString() + (suffix || '');
        }
      });
    }

    animateCounter('stat-calls', 12847, '', '');
    animateCounter('stat-cost', 47, '$', '');
    animateCounter('stat-diagnose', 3291, '', '');
    animateCounter('stat-query', 9556, '', '');

    // Budget bar animation
    const budgetBar = document.getElementById('budget-bar');
    const budgetPct = document.getElementById('budget-pct');
    if (budgetBar) {
      gsap.to(budgetBar, {
        width: '47%',
        duration: 1.5,
        delay: 1,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: '#usage-card',
          start: 'top 80%',
          toggleActions: 'play none none none'
        },
        onUpdate: function() {
          if (budgetPct) {
            const w = parseFloat(budgetBar.style.width) || 0;
            budgetPct.textContent = Math.round(w) + '%';
          }
        }
      });
    }
  }

  initAnimations();

  // ---- OAuth button click handlers (placeholder) ----
  document.getElementById('btn-google')?.addEventListener('click', () => {
    alert('Google OAuth coming soon. Join the waitlist at savants.dev');
  });
  document.getElementById('btn-github')?.addEventListener('click', () => {
    alert('GitHub OAuth coming soon. Join the waitlist at savants.dev');
  });
  document.getElementById('btn-email')?.addEventListener('click', () => {
    const email = document.getElementById('email-input')?.value;
    if (email && email.includes('@')) {
      alert('We\'ll send a magic link to ' + email + ' when Savants Cloud launches.');
    } else {
      alert('Please enter a valid email address.');
    }
  });
  document.getElementById('btn-cloud-signup')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    document.getElementById('email-input')?.focus();
  });
</script>
</Base>
